PIDFILE = REPO / "hub" / ".serve.pid"
SERVE_LOG = REPO / "hub" / "serve.log"
CRON_MARK = "# atlas-hub weekly update"
ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,40}$")
STEPS = {
    "harvest": "engine.harvest_arxiv", "harvest-oa": "engine.harvest_openalex", "merge": "engine.merge",
    "classify": "engine.classify", "resolve": "engine.resolve_venues", "build": "engine.build",
    "digest": "engine.digest", "recall": "engine.recall_check", "read": "engine.read", "comparable": "engine.comparable", "audit": "engine.audit", "variants": "engine.variants", "affil": "engine.affil", "share": "engine.shared",
    "survey": "engine.survey", "ask": "engine.ask", "export": "engine.export",
}
ENV_PATH = os.pathsep.join([str(Path.home() / ".local" / "bin"), os.environ.get("PATH", "/usr/bin:/bin")])


def default_host() -> str:
    """Bind address: ATLAS_HOST, else local.json "host", else this machine only."""
    try:
        cfg = json.loads((REPO / "local.json").read_text())
    except (OSError, ValueError):
        cfg = {}
    return os.environ.get("ATLAS_HOST") or cfg.get("host") or "127.0.0.1"


def die(msg: str) -> None:
    sys.exit(f"atlas: {msg}")


def atlas_ids() -> list[str]:
    return sorted(p.name for p in ATLASES.iterdir() if p.is_dir() and ID_RE.match(p.name) and (p / "atlas.py").exists())


def need(aid: str) -> str:
    if aid not in atlas_ids():
        die(f"no atlas '{aid}' — have: {', '.join(atlas_ids()) or '(none)'}")
    return aid


def domain(aid: str):
    spec = importlib.util.spec_from_file_location(f"d_{aid}", ATLASES / aid / "atlas.py")
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def run_step(aid: str, step: str, args: list[str], log=None) -> int:
    env = {**os.environ, "ATLAS": aid, "PATH": ENV_PATH, "PYTHONUNBUFFERED": "1"}
    cmd = [sys.executable, "-m", STEPS[step], *args]
    if log is None:
        return subprocess.call(cmd, cwd=REPO, env=env)
    p = subprocess.Popen(cmd, cwd=REPO, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for line in p.stdout:
        sys.stdout.write(line)
        log.write(line)
        log.flush()
    return p.wait()


class Lock:
    """One pipeline run per atlas at a time (cron + a manual run must not both write labels)."""

    def __init__(self, aid: str):
        self.path = ATLASES / aid / "data" / ".update.lock"
        self.path.parent.mkdir(parents=True, exist_ok=True)

    def __enter__(self):
        self.f = open(self.path, "w")
        try:
            fcntl.flock(self.f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            self.f.close()
            return None
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()



META_KEYS = ("title", "subtitle", "description", "field")


def set_meta(aid: str, patch: dict) -> None:
    """Rewrite keys inside the META = {...} block of atlases/<id>/atlas.py (display fields only),
    and patch public/meta.json so the hub shows the change without a rebuild."""
    f = ATLASES / aid / "atlas.py"
    src = f.read_text()
    m = re.search(r"^META = \{\n(.*?)^\}", src, re.S | re.M)
    if not m:
        die(f"no META block in {f}")
    block = m.group(1)
    for k, v in patch.items():
        if k not in META_KEYS or v is None:
            continue
        lit = json.dumps(str(v).strip(), ensure_ascii=False)
        line_re = re.compile(rf'^(\s*)"{k}":\s*(?:"(?:[^"\\]|\\.)*"|\([^)]*\)),?[^\n]*$', re.M)
        if line_re.search(block):
            block = line_re.sub(lambda mm: f'{mm.group(1)}"{k}": {lit},', block, count=1)
        else:
            block = block.rstrip("\n") + f'\n    "{k}": {lit},\n'
    src = src[: m.start(1)] + block + src[m.end(1):]
    compile(src, str(f), "exec")  # never leave a broken domain file behind
    f.write_text(src)
    pm = ATLASES / aid / "public" / "meta.json"
    if pm.exists():
        meta = json.loads(pm.read_text())
        meta.update({k: v for k, v in patch.items() if k in META_KEYS and v is not None})
        pm.write_text(json.dumps(meta, ensure_ascii=False, indent=1))


def check_domain(aid: str) -> list[str]:
    """Return a list of problems (empty = ready to run)."""
    errs = []
    try:
        d = domain(aid)
    except Exception as ex:  # syntax / import error
        return [f"atlas.py does not load: {ex!r}"]
    need_names = ["META", "ARXIV_QUERIES", "OPENALEX_QUERIES", "RELEVANCE_RE", "OA_STRICT_RE", "OA_STRICT_CS_RE",
                  "SCOPES", "TASKS", "SETTINGS", "PARADIGMS", "CONTRIBS", "TRAITS", "BENCHMARKS",
                  "CLASSIFY_ROLE", "CLASSIFY_RULES", "LANDMARKS", "UI"]
    errs += [f"missing {n}" for n in need_names if not hasattr(d, n)]
    if errs:
        return errs
    scopes = [s[0] for s in d.SCOPES]
    if "core" not in scopes or "out" not in scopes:
        errs.append("SCOPES must contain 'core' and 'out'")
    if not d.PARADIGMS or d.PARADIGMS[-1][0] != "none":
        errs.append("PARADIGMS must end with a 'none' paradigm")
    if any(len(p) != 4 for p in d.PARADIGMS):
        errs.append("PARADIGMS entries are (code, label, line, definition)")
    if len(d.ARXIV_QUERIES) < 5:
        errs.append(f"only {len(d.ARXIV_QUERIES)} arXiv queries (playbook: 40-60)")
    try:
        json.dumps(d.UI)
    except TypeError as ex:
        errs.append(f"UI is not JSON-serialisable: {ex}")
    src = (ATLASES / aid / "atlas.py").read_text()
    todo = len(re.findall(r"\bTODO", src))
    if todo:
        errs.append(f"{todo} TODO placeholder(s) left in atlas.py")
    if META_ID := getattr(d, "META", {}).get("id"):
        if META_ID != aid:
            errs.append(f"META id '{META_ID}' != folder '{aid}'")
    return errs


# ───────────────────────── commands ─────────────────────────
def cmd_list(_):
    print(f"{'id':14s} {'title':28s} {'core':>6s} {'total':>6s}  built       ready")
    for i in atlas_ids():
        m = {}
        try:
            m = json.loads((ATLASES / i / "public" / "meta.json").read_text())
        except (OSError, ValueError):
            pass
        ready = getattr(domain(i), "DOMAIN_READY", False)
        print(f"{i:14s} {str(m.get('title', '—'))[:28]:28s} {m.get('n_core', 0):6d} {m.get('n_papers', 0):6d}  "
              f"{(m.get('built_at') or 'not built')[:10]:10s}  {'yes' if ready else 'NO (edit atlas.py)'}")


def cmd_new(a):
    aid = a.id
    if not ID_RE.match(aid) or aid.startswith("_"):
        die("id must be lowercase letters/digits/-/_ (e.g. agentatlas)")
    dst = ATLASES / aid
    if dst.exists():
        die(f"{dst} already exists")
    shutil.copytree(ATLASES / "_template", dst)
    f = dst / "atlas.py"
    s = f.read_text()
    for k, v in {"{{ID}}": aid, "{{TITLE}}": a.title, "{{SUBTITLE}}": a.subtitle or f"{a.field or a.title} Literature Atlas",
                 "{{FIELD}}": a.field or a.title, "{{TODAY}}": date.today().isoformat()}.items():
        s = s.replace(k, v)
    f.write_text(s)
    if a.description:
        set_meta(aid, {"description": a.description})
    (dst / "seeds.txt").write_text("# Extra arXiv ids harvested by id (papers the queries miss). One per line, '#' comments.\n")
    (dst / "overrides.json").write_text("{}\n")
    print(f"created atlases/{aid}/ — next:\n"
          f"  1. edit atlases/{aid}/atlas.py (scope + taxonomy first, agree them with the user; then queries, rules, landmarks, UI)\n"
          f"  2. set DOMAIN_READY = True\n"
          f"  3. ./atlas classify {aid} --print-prompt     # read the rendered classifier prompt\n"
          f"  4. ./atlas update {aid} --full                # first full run (harvest ~30 min, classify ~40 min per 10k)\n"
          f"  playbook: claude/skills/literature-atlas/playbook.md")


def cmd_update(a):
    ids = [i for i in atlas_ids() if getattr(domain(i), "DOMAIN_READY", False)] if a.all else [need(a.id)]
    if not ids:
        die("no atlas with DOMAIN_READY = True")
    for aid in ids:
        with Lock(aid) as lk:
            if lk is None:
                print(f"[{aid}] another update is running — skipped")
                continue
            logs = ATLASES / aid / "data" / "logs"
            logs.mkdir(parents=True, exist_ok=True)
            with open(logs / f"update-{datetime.now():%Y%m%d-%H%M}.log", "a") as log:
                def step(name, *args):
                    log.write(f"-- {name} {' '.join(args)}\n")
                    print(f"[{aid}] -- {name} {' '.join(args)}", flush=True)
                    rc = run_step(aid, name, list(args), log)
                    if rc:
                        msg = f"!! {name} failed (exit {rc}) — continuing; retried next run\n"
                        log.write(msg)
                        print(msg, end="")
                    return rc

                print(f"== {aid} update {datetime.now().isoformat(timespec='seconds')}")
                if a.full:
                    step("harvest")
                    step("harvest-oa")
                else:
                    step("harvest", "--since", (date.today() - timedelta(days=62)).strftime("%Y-%m"))
                step("merge")
                step("classify", "--workers", "4", *(["--prescreen", a.prescreen] if a.prescreen else []))
                step("resolve")
                step("affil", "--openalex")  # industry authorship: cached full texts, then OpenAlex for the rest (stops at the daily budget)
                step("build")
                step("digest", "--since", (date.today() - timedelta(days=6)).isoformat())
                step("recall")
                print(f"== {aid} done {datetime.now().isoformat(timespec='seconds')}")


def cmd_add(a):
    aid = need(a.id)
    ids = []
    for x in a.papers:
        m = re.search(r"(\d{4}\.\d{4,5})", x)
        if not m:
            print(f"not an arXiv id: {x}")
            continue
        ids.append(m.group(1))
    if not ids:
        die("no arXiv ids given")
    seeds = ATLASES / aid / "seeds.txt"
    have = seeds.read_text() if seeds.exists() else ""
    with open(seeds, "a") as f:
        for i in ids:
            if not re.search(rf"^{re.escape(i)}\b", have, re.M):
                f.write(f"{i}  # added {date.today()} via atlas add\n")
    with Lock(aid) as lk:
        if lk is None:
            die("an update is running — try again in a few minutes")
        for s, args in [("harvest", ["--seeds-only"]), ("merge", []), ("classify", ["--workers", "2"]), ("resolve", []), ("build", [])]:
            run_step(aid, s, args)
    papers = {p["id"]: p for p in json.loads((ATLASES / aid / "public" / "papers.json").read_text())}
    excl = {e["id"]: e for e in json.loads((ATLASES / aid / "public" / "excluded.json").read_text())}
    for i in ids:
        p = papers.get(i)
        if p:
            print(f"✓ {i} [{p['sc']}] {p.get('n') or ''} — {p['t'][:70]}\n    {p['pd']} · {', '.join(p['tk'])} · {p.get('v') or 'arXiv'}\n"
                  f"    http://localhost:8668/#/{aid}/paper?{i}")
        elif i in excl:
            print(f"✗ {i} excluded ({excl[i]['why']}) — {excl[i]['t'][:70]}\n"
                  f"    wrong? add {{\"{i}\": {{\"scope\": \"core\"}}}} to atlases/{aid}/overrides.json, then ./atlas build {aid}")
        else:
            print(f"? {i} not found on arXiv")


def cmd_step(a):
    sys.exit(run_step(need(a.id), a.cmd, a.rest))


# ── hub server ──
def _pid() -> int | None:
    try:
        pid = int(PIDFILE.read_text())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def cmd_serve(a):
    os.execv(sys.executable, [sys.executable, str(REPO / "hub" / "serve.py"), "--port", str(a.port), "--host", a.host])


def cmd_start(a):
    if _pid():
        print(f"hub already running (pid {_pid()})")
        return
    with open(SERVE_LOG, "a") as log:
        p = subprocess.Popen([sys.executable, str(REPO / "hub" / "serve.py"), "--port", str(a.port), "--host", a.host],
                             cwd=REPO, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    PIDFILE.write_text(str(p.pid))
    time.sleep(0.6)
    print(f"hub started (pid {p.pid}) → http://localhost:{a.port}/" if p.poll() is None else f"hub failed to start — see {SERVE_LOG}")


def cmd_stop(_):
    pid = _pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
        print(f"stopped (pid {pid})")
    else:
        print("not running")
    PIDFILE.unlink(missing_ok=True)


def cmd_status(_):
    pid = _pid()
    print(f"hub running (pid {pid})" if pid else "hub not running")
    cmd_list(None)


