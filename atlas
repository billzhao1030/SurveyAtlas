#!/usr/bin/env python3
"""atlas — one command for every literature atlas in this repo.

  ./atlas list                                   atlases, sizes, build dates
  ./atlas new <id> --title T [--subtitle S] [--field F] [--description D]   scaffold atlases/<id>
  ./atlas meta <id> [--title T] [--subtitle S] [--description D]   rename / re-describe (display only)
  ./atlas rename <old-id> <new-id>              change an atlas's id (folder, URLs, default setting)
  ./atlas delete <id> [--force]                  remove an atlas (refuses one with data unless --force)
  ./atlas draft <id> --brief "…"                 headless Claude drafts atlas.py from a brief (stays not-ready)
  ./atlas check <id>                             validate the domain file · ./atlas ready <id>: check + unlock
  ./atlas update <id>|--all [--full] [--prescreen haiku]   harvest → merge → classify → venues → build → digest
  ./atlas add <id> <arXiv id or URL>...          add specific papers now (~1 min)
  ./atlas build <id>                             rebuild atlases/<id>/public/ from data/
  ./atlas <step> <id> [args]                     single step: harvest | harvest-oa | merge | classify |
                                                 resolve | build | digest | recall | read (deep reading)
  ./atlas ask <id> "question"                    answer a question from the atlas (cites papers; needs the claude CLI)
  ./atlas export <id> <dir> [--keep-surveys]     static read-only copy of the site (GitHub Pages, any web host)
  ./atlas survey <id> <sid> init|assign|packs|bib|pdf|status   survey workspace (atlases/<id>/surveys/<sid>/)
  ./atlas serve [--port 8668] [--host H]         run the hub in the foreground (127.0.0.1 unless --host / local.json "host")
  ./atlas start | stop | status                  run the hub in the background (hub/.serve.pid)
  ./atlas snapshot <id> [--with-raw]             pack data/ into atlases/<id>/snapshot/ (commit it)
  ./atlas restore <id> [--force]                 unpack snapshot/ into data/ and rebuild
  ./atlas backup [--no-push]                     snapshot every atlas + commit the snapshots (+ push if a remote exists)
  ./atlas admin-key [--rotate]                   key + one-time links that unlock editing from another device
  ./atlas password [--set PW]                    site password other devices must enter (initially 0000)
  ./atlas cron install [--daily | --when "13 5 * * 0"] [--publish] | remove | show   scheduled `update --all` (default weekly;
                                                 --publish also commits + pushes the snapshots so the public site redeploys)

Engine steps run as `ATLAS=<id> python3 -m engine.<step>` from the repo root.
"""
